{
  "entities": {
    "CounterLocation": {
      "title": "CounterLocation",
      "description": "Counter location with queue lines and real-time voting counts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "landmark": { "type": "string" },
        "shortAddress": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "bestLineId": { "type": "string" },
        "bestLineNumber": { "type": "number" },
        "bestLineChance": { "type": "number" },
        "totalReportsCount": { "type": "number" },
        "isOpen": { "type": "boolean" },
        "operatingHours": { "type": "string" }
      },
      "required": ["id", "name", "isOpen"]
    },
    "UserQueueReport": {
      "title": "UserQueueReport",
      "description": "Devotee queue vote submission",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "locationId": { "type": "string" },
        "queueId": { "type": "string" },
        "locationName": { "type": "string" },
        "lineName": { "type": "string" },
        "peopleCount": { "type": "number" },
        "timestamp": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "userId", "locationId", "queueId"]
    }
  },
  "firestore": {
    "/locations/{locationId}": {
      "schema": "CounterLocation",
      "description": "Information about counter centers and their queue lines with live voting numbers"
    },
    "/reports/{reportId}": {
      "schema": "UserQueueReport",
      "description": "Historical devotee votes and queue submissions"
    }
  }
}
